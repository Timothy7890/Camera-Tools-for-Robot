# 复制为 .env 后修改。docker compose 会自动读取。

# 机器人侧推送用的写 token（必填，否则拒绝一切上传）。生成：openssl rand -hex 32
CALIB_API_TOKEN=change-me

# 读接口是否也需要 token（公网部署建议 1；内网可 0 让浏览器直接看）
CALIB_READ_REQUIRES_TOKEN=0

# 对外端口（宿主机）
CALIB_PORT=8080

# 允许跨域来源，逗号分隔；前端与后端同容器时保持 *
CALIB_CORS_ORIGINS=*

# 单文件上传上限 MB
CALIB_MAX_FILE_MB=64
