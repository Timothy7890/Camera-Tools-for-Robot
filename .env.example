# 复制为 .env 后修改。systemd 单元通过 EnvironmentFile 读取本文件（不要加引号、不要用 export）。

# 机器人侧推送用的写 token（必填，否则拒绝一切上传）。生成：openssl rand -hex 32
CALIB_API_TOKEN=change-me

# 读接口是否也需要 token（公网部署建议 1；内网可 0 让浏览器直接看）
CALIB_READ_REQUIRES_TOKEN=0

# 监听地址 / 端口。默认只听本机，由 Nginx 反代（deploy/nginx/）对外提供 https；
# 不用 Nginx、想直接用 http://<ip>:8080 访问时改成 0.0.0.0
CALIB_HOST=127.0.0.1
CALIB_PORT=8080

# 数据目录（SQLite + 产物文件）。不填默认 <仓库>/data；改了路径要同步改 service 里的 ReadWritePaths
# CALIB_DATA_DIR=/srv/calib-cloud/data

# URDF / STL 模型目录。不填默认 <仓库>/models
# CALIB_MODELS_DIR=/opt/calib-cloud/models

# 允许跨域来源，逗号分隔；前端与后端同源托管时保持 *
CALIB_CORS_ORIGINS=*

# 单文件上传上限 MB
CALIB_MAX_FILE_MB=64

# 相机标定上传后在后台自动生成 WebP 预览图；服务器未安装 renderer 依赖时可临时关闭
CALIB_PREVIEW_ENABLED=1
