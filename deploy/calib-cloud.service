# systemd 单元（参考）。deploy/install.sh 会把 __APP_DIR__ / __USER__ 替换成实际值后
# 安装到 /etc/systemd/system/calib-cloud.service。手工安装时自行替换这两个占位符。
[Unit]
Description=Camera calibration cloud platform (calib_cloud)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__/backend
# 环境变量（CALIB_API_TOKEN / CALIB_DATA_DIR / CALIB_PORT ...）都放这里，见 .env.example
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/backend/.venv/bin/uvicorn calib_cloud.main:app \
    --host ${CALIB_HOST} --port ${CALIB_PORT} \
    --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=3

# 基本加固：只允许写数据目录
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__APP_DIR__/data

[Install]
WantedBy=multi-user.target
